# ===== 必填 =====
# 管理口令：面板登录用。留空则每次启动随机生成并打印在日志里。
ADMIN_TOKEN=

# 凭据加密密钥：账号 token 用它做 AES-256-GCM 加密后落库。
# 换了这个值，已有账号的 token 就解不开了，需要重新导入。
SECRET_KEY=

# 不加密直接明文落库（仅本机自用且不在意时用）。设了 SECRET_KEY 就不需要它。
# ALLOW_PLAINTEXT=1

# ===== 常用 =====
LISTEN_ADDR=0.0.0.0:8080
DATA_DIR=/data
TZ=Asia/Shanghai

# 选号策略：optimal | round_robin | credit_first | manual | expire_first
POOL_STRATEGY=optimal
# 单请求最多换号次数
MAX_RETRIES=3

# ===== 自动签到 =====
CHECKIN_ENABLE=true
# 每日基准时刻（本地时区），每个账号再叠加 0~JITTER 分钟确定性抖动
CHECKIN_HOUR=0
CHECKIN_MINUTE=10
CHECKIN_JITTER_MINUTES=30
# 账号之间的随机间隔（毫秒），防风控
CHECKIN_GAP_MIN_MS=800
CHECKIN_GAP_MAX_MS=2000

# ===== 进阶 =====
# access 临期多少秒内才刷新。抢在客户端前面刷会把 refresh_token 轮换掉，两边都掉登录。
REFRESH_WINDOW_SEC=300
# 上游多久无数据判定超时
STREAM_IDLE_TIMEOUT_SEC=120
# 请求体上限（MB），含 base64 图片
MAX_BODY_MB=32
# 模型级负缓存（某个号对某个模型失败时只罚这一对组合）
MODEL_COOLDOWN_ENABLE=true

# 可选：启用回环回调登录路径（需要上游接受 redirect_uri，实测可用后再开）
# OAUTH_REDIRECT_BASE=https://relay.example.com
