# ===== 必填 =====
# 管理口令：面板登录用。留空则每次启动随机生成并打印在日志里。
ADMIN_TOKEN=

# 凭据加密密钥：账号 token 用它做 AES-256-GCM 加密后落库。
# 换了这个值，已有账号的 token 就解不开了，需要重新导入。
SECRET_KEY=

# 不加密直接明文落库（仅本机自用且不在意时用）。设了 SECRET_KEY 就不需要它。
# ALLOW_PLAINTEXT=1

# ===== 常用 =====
LISTEN_ADDR=0.0.0.0:8080
DATA_DIR=/data
TZ=Asia/Shanghai

# ===== 数据库 =====
# 留空：使用 $DATA_DIR/relay.db（SQLite，单机默认）。
# 填 postgres://...：连接 Postgres，连接池默认 20/10。
# 首次从 SQLite 切到 Postgres 时，启动会自动把 relay.db 迁过去并改名为
# relay.db.migrated-<时间戳>；迁移失败会中止启动，不会静默起一个空库。
# DATABASE_URL=postgres://relay:password@postgres:5432/relay?sslmode=disable
# 连接池上限（0 = 按方言取默认：SQLite 1/1，Postgres 20/10）
# DB_MAX_OPEN_CONNS=20
# DB_MAX_IDLE_CONNS=10
# 旧 SQLite 库的启动迁移策略：
#   auto（默认）= 目标库为空且存在 relay.db 时自动迁移；
#   off         = 不迁移，直接起 Postgres；
#   require     = 没有旧库也要求迁移（库被误删时尽早失败）。
# MIGRATE_SQLITE=auto

# ===== Redis（多实例协调）=====
# 留空：进程内实现，单实例行为与以前一致。
# 有值：后台任务（签到/冷却巡检/清理/续期）在多个副本间只跑一份，
#       API Key 校验结果还可跨副本缓存。
# Redis 不可用时自动降级为本地实现并告警，不阻止启动。
# REDIS_URL=redis://:password@redis:6379/0
# REDIS_PREFIX=raccoon:
# 多副本建议开启：Redis 连不上就拒绝启动，避免锁静默失效。
# REDIS_REQUIRED=0

# ===== 并发上限（超出排队）=====
# 同时转发到上游的请求数上限。超出的请求不返回 429，而是排队等待，
# 前面的请求结束后自动继续；排队超过 QUEUE_WAIT_SEC 才返回 503。
# 0 = 不限制（默认，保持原有行为）。
# 配置了 REDIS_URL 时计数跨实例共享，多副本合计仍不超过这个上限。
# MAX_CONCURRENT=8
# 最长排队时间（秒），默认 600。
# QUEUE_WAIT_SEC=600

# 选号策略：load_balance（负载均衡，默认） | round_robin（轮询）
# 旧值 optimal / credit_first / manual / expire_first 会自动按 load_balance 处理
POOL_STRATEGY=load_balance
# 单请求最多换号次数（面板的「自动换号重试」关闭时生效）
MAX_RETRIES=3
# 自动换号重试：开启后遇到可换号错误（429/402/401/5xx 等）按序试完整个号池，
# 直到没有可用账号为止，此时 MAX_RETRIES 不生效
RETRY_UNTIL_EXHAUSTED=false

# ===== 调度形态（面板「设置 → 调度」可改，这里只是首次启动的默认值）=====
# 这三组参数共同决定「一次请求在外部看起来是什么形态」。
# 上游风控看的是同一账号一段时间内接了多少互不相干的请求。

# 单号串行：同一账号同时只处理一个请求，其余换号。默认开启。
# 关闭则允许同号并发（升级前的行为）。
LEASE_ENABLE=true
# 租约时长（秒）。长回答按 1/3 滚动续期；进程崩溃留下的残租约到期自动失效。
LEASE_TTL_SEC=300

# 换号间隔（毫秒）。失败后等一会儿再换号，避免同一秒横扫整个号池。
RETRY_DELAY_MS=800

# 失败后退避：403/5xx/网络抖动后，该号在窗口内暂不被选中。
# 时长从起点逐次翻倍、封顶上限；不改账号状态（与「冷却」不同），成功即清零。
BACKOFF_ENABLE=true
BACKOFF_BASE_MS=2000
BACKOFF_MAX_MS=60000

# 会话粘性：同一段对话优先复用上次成功的账号。
# 会话标识取 X-Session-Id / X-Conversation-Id / session_id / conversation_id。
SESSION_AFFINITY_ENABLE=true
# 绑定有效期（秒）
SESSION_AFFINITY_TTL_SEC=86400

# ===== 自动签到 =====
CHECKIN_ENABLE=true
# 每日基准时刻（本地时区），每个账号再叠加 0~JITTER 分钟确定性抖动
CHECKIN_HOUR=0
CHECKIN_MINUTE=10
CHECKIN_JITTER_MINUTES=30
# 账号之间的随机间隔（毫秒），防风控
CHECKIN_GAP_MIN_MS=800
CHECKIN_GAP_MAX_MS=2000

# ===== 进阶 =====
# access 临期多少秒内才刷新。抢在客户端前面刷会把 refresh_token 轮换掉，两边都掉登录。
REFRESH_WINDOW_SEC=300
# 主动续期：小浣熊 token 有效期 30 天。后台提前这么多秒统一刷新临期号，
# 避免冷门号因长期没被选中而静默过期（0 = 关闭主动续期）。
# 默认提前 3 天，仍远小于 30 天，不会跟桌面客户端抢刷新。
RENEW_WINDOW_SEC=259200
# 主动续期的扫描间隔（分钟）
RENEW_INTERVAL_MIN=360
# 主动续期时账号之间的间隔（毫秒），防风控
RENEW_GAP_MS=1000
# 余额巡检：余额平时只在签到/导入/手动查询时更新，签到失败的号与没有签到的日日新
# 会长期停在旧值。开启后每 BALANCE_SYNC_INTERVAL_MIN 分钟巡一轮，只查超过
# BALANCE_SYNC_STALE_MIN 分钟没更新的启用账号。0 = 关闭周期巡检。
# 面板「设置 → 余额巡检」可改并持久化，这里只是首次启动的默认值。
BALANCE_SYNC_INTERVAL_MIN=10
BALANCE_SYNC_STALE_MIN=30
# 对话流「多久没收到上游数据」判定超时（不是整条回答的总时限，长回答不会因此被掐断）
STREAM_IDLE_TIMEOUT_SEC=120
# 非流式端点（登录/余额/签到/目录）的整体超时
UPSTREAM_TIMEOUT_SEC=120
# 请求体上限（MB），含 base64 图片
MAX_BODY_MB=32
# 模型级冷却：429 只冷却「账号 × 模型」，账号本身保持可用。
# 关闭后 429 会退化成整号冷却 60 秒。面板里可随时切换。
MODEL_COOLDOWN_ENABLE=true
# 200108「账号存在异常调用」按账号级冷却：上游罚的是整个账号，换模型绕不过去。
# 冷却阶梯与 429 相同（3 → 5 → 10… 分钟，封顶 24 小时），到期自动恢复。
# 面板「设置 → 冷却与积分阈值」可随时切换，改完立即生效并持久化。
ACCOUNT_ABNORMAL_COOL=true
# 积分阈值冷却：低于 CREDIT_STOP_BELOW 暂停该号，回升到 CREDIT_RESUME_ABOVE 解除。
# 面板「设置 → 冷却与积分阈值」里改会持久化并覆盖这里的默认值。
CREDIT_STOP_ENABLE=false
CREDIT_STOP_BELOW=0
CREDIT_RESUME_ABOVE=0

# ===== 日志管理 =====
# 这几项都能在面板「设置 → 日志管理」里改，改完立即生效并持久化到数据库；
# 这里只是首次启动的默认值。
# 是否把运行日志写到文件（关闭则只输出到标准错误/容器日志）
LOG_FILE_ENABLE=true
# 日志目录，相对路径按 DATA_DIR 解析
LOG_DIR=/data/logs
# 单个日志文件上限（MB），超过立即轮转
LOG_MAX_SIZE_MB=32
# 归档文件数量上限
LOG_MAX_FILES=10
# 归档文件保留天数（0 = 不按天数，只按数量上限）
LOG_FILE_RETAIN_DAYS=7
# 调用流水 / 签到记录保留天数（0 = 不清理数据库）
LOG_DB_RETAIN_DAYS=30
# 是否自动清理
LOG_CLEAN_ENABLE=true
# 自动清理间隔（分钟）
LOG_CLEAN_INTERVAL_MINUTES=60

# ===== 客户端指纹 =====
# 决定我们向小浣熊上游「以什么身份自称」，对话、签到、余额、续期共用一份。
# 这几项都能在面板「设置 → 客户端指纹」里改，改完立即生效并持久化到数据库；
# 这里只是首次启动的默认值。
#
# 上游桌面客户端发版后旧版本号会过期，「旧版本号 + 全新会话」是第三方客户端
# 最典型的特征，所以版本变化时在面板里直接改，不必重新发版。
CLIENT_VERSION=1.0.35
WEB_CLIENT_VERSION=v1.1.3
CLIENT_OS_VERSION=10.0.26200
CLIENT_PLATFORM=desktop-windows-x64
# User-Agent 留空 = 按上面的版本号自动派生（raccoon-ai/<版本号>）。
# 显式填写则原样发送；千万别填成 Go 的缺省值，那会和「自称桌面客户端」自相矛盾。
# CLIENT_USER_AGENT=
# WEB_USER_AGENT=

# 可选：启用回环回调登录路径（需要上游接受 redirect_uri，实测可用后再开）
# OAUTH_REDIRECT_BASE=https://relay.example.com

# ===== 网关出站改写（面板「设置 → 网关」可改，这里只是首次启动的默认值）=====
# 这三项都只改「发给上游的副本」：客户端发来的原文与上游返回的响应都不变。
#
# 出站请求指纹脱敏：按词表改写发给上游的文本（system / user / assistant 等
# 消息正文、推理内容与工具参数），让上游的客户端指纹识别失配。
# 词表在面板里编辑（默认内置一份，可增删改），这里只控制开关与首次启动的默认值。
SANITIZE_ENABLE=true
# 脱敏应用范围：空格或逗号分隔的提供商 id（raccoon / sensenova / autoclaw /
# codearts）。留空 = 应用到全部提供商（含之后新增的）。
# SANITIZE_PROVIDERS=
# 开发者角色兼容：转发前把 messages 里 role:"developer" 的消息改写为 "system"。
# OpenAI 新版 API 用 developer 承载指令，部分兼容上游不认识会直接 400。
DEVELOPER_ROLE_COMPAT=true
# models.dev 模型元数据：用社区库补齐上游没声明的模型能力位与思考档位。
# 优先级：用户覆盖 > 上游声明 > models.dev > 未声明。随包内嵌一份快照，
# 离线也有数据；开启时可联网刷新（面板里可立即刷新）。关闭只停联网刷新。
MODELS_DEV_ENABLE=true

# ===== 外部渠道上游地址（面板「设置 → 外部渠道」可改，这里只是首次启动的默认值）=====
# 全部留空 = 使用内置默认地址；只有上游改域名或自建代理时才需要填。
# 地址须以 http:// 或 https:// 开头，不能带用户名密码、查询串或片段。
#   AutoClaw 国际站（网页 OAuth）
# AUTOCLAW_INTL_BASE=https://autoglm-api.autoglm.ai
#   AutoClaw 国内站（手机验证码）
# AUTOCLAW_CN_BASE=https://autoglm-api.zhipuai.cn
#   AutoClaw 国内对话网关
# AUTOCLAW_CN_MANAGED_BASE=https://autoglm-acceleration-api.zhipuai.cn
#   码道（CodeArts）国内站
# CODEARTS_MAINLAND_BASE=https://snap-access.cn-north-4.myhuaweicloud.com
#   码道（CodeArts）国际站
# CODEARTS_INTL_BASE=https://snap-access.ap-southeast-1.myhuaweicloud.com

# ===== 一键更新 =====
# 面板「版本更新」从 GitHub Release 拉取对应平台的二进制并做 sha256 校验。
# 默认指向本项目仓库，一般不用改。私有 fork 可改 UPDATE_REPO，并填 GITHUB_TOKEN。
# UPDATE_REPO=3166790565/raccoon-relay
# GITHUB_TOKEN=
# GitHub API 被墙时可换成镜像
# UPDATE_API_BASE=https://api.github.com
# 默认直连 GitHub；检查/下载失败会依次自动改用镜像源兜底（无需配置）。
# 内置镜像：gh-proxy.com、cdn.gh-proxy.org、o-o.men。
# 需要自定义镜像列表时填这一项（空格或逗号分隔，直连仍然优先）：
# UPDATE_MIRRORS=https://gh-proxy.com https://cdn.gh-proxy.org https://o-o.men
# 旧版单镜像配置：填了就只走它，不再自动兜底（优先级高于 UPDATE_MIRRORS）
# UPDATE_DOWNLOAD_BASE=
# 手动指定安装目标（默认：容器内 /data/bin/relay，裸机为当前可执行文件）
# UPDATE_TARGET=
